@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "Page Title";
}

@model IEnumerable<EcommerceMVC.Models.ResponseMoviesModel>

<div class="container mt-4">
    <h1 class="mb-4">User Dashboard.. Welcome!!!</h1>

    <div class="row">
        @foreach (var movie in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img class="card-img-top" src="@movie.ImageUrl" alt="@movie.Title">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@movie.Title</h5>
                        <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                        <a href="#" class="btn btn-primary mt-auto">More...</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>  

<form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline;"> 
    @Html.AntiForgeryToken() 
    <button type="submit">Logout</button> 
</form> 




