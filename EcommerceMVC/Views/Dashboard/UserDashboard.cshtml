@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "Dashboard";
}

@model IEnumerable<EcommerceMVC.Models.ResponseMoviesModel>

@{

    int totalQuantity = Context.Session.GetInt32("Quantity") ?? 0;

}

<div class="container py-4">

    @if (TempData["UserName"] != null)
    {
        <div class="alert alert-success shadow-sm">
            Welcome, <strong>@TempData["UserName"]</strong> 👋
        </div>
    }

    <!-- Search -->
    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="SearchString"
            class="form-control"
            placeholder="Search movies..." />
            <button class="btn btn-primary"
            asp-action="UserDashboard"
            asp-controller="Dashboard">
                Search
            </button>
        </div>
    </form>

    <!-- Add to Cart -->
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Cart"
           asp-action="Cart"
           class="position-relative d-inline-block text-decoration-none">

            <i class="fa-solid fa-cart-shopping fs-4"></i>
            @* <span class="ms-1">View Cart</span> *@
            @if (totalQuantity > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @totalQuantity
                </span>
            }
        </a>
    </div>

    @* <p>Session Value: @Context.Session.GetInt32("Quantity")</p> *@

    <!-- Movies -->
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">

                    <img src="@movie.ImageUrl"
                    class="card-img-top"
                    style="height:300px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">
                            @movie.Title
                        </h5>

                        <p class="text-muted small">
                            Release: @movie.ReleaseDate
                        </p>

                        <div class="mt-auto">
                            <a asp-controller="Movie"
                            asp-action="DetailsMovie"
                            asp-route-id="@movie.Id"
                            class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>
                        </div>
                    </div>

                    <form asp-action="AddToCart" method="post" asp-controller="Cart" asp-route-id ="@movie.Id">
                        <input type="hidden" name="id" value="@movie.Id" />
    
                        <div class="card-footer bg-white border-0 ">
                            <div class="d-flex justify-content-between align-items-center">
                                <p>Quantity</p>
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="decreaseQty(this)">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>

                                    @* <span class="quantity">1</span> *@
                                    <!-- Change span to input -->
                                    <input type="text" name="quantity" value="1" class="quantity-input" readonly style="width:40px; text-align:center; border:none;" />


                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="increaseQty(this)">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success">
                                    @movie.Price Ks
                                </span>

                                <button type="submit" class="btn btn-sm btn-warning">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                    Add
                                </button>
                            </div>

                        </div>
                    </form>

                </div>
            </div>
        }
    </div>

</div>

<script>

    function increaseQty(button) {
        const input = button.parentElement.querySelector(".quantity-input");
        let count = parseInt(input.value);
        count++;
        input.value = count;
    }

    function decreaseQty(button) {
        const input = button.parentElement.querySelector(".quantity-input");
        let count = parseInt(input.value);
        if (count > 1) {
            count--;
            input.value = count;
        }
    }

