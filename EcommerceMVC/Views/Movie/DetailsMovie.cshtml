

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Page Title";
}

@model EcommerceMVC.Models.ResponseMoviesModel

<div class="row">
    <div class="col-6">
        <img src="@Model.ImageUrl" alt="@Model.Title" height="300" width="200">

    </div>
    <div class="col-6">
        <h4>@Model.Title</h4>
        <h4>@Model.Genre</h4>
        <h4>@Model.Price</h4>
        <h4>@Model.ReleaseDate</h4>


    </div>
</div>


