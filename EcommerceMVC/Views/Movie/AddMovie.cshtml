

@{
	ViewData["Title"] = "AddMovies";
}

@model EcommerceMVC.Models.RequestNewMovieModel


<h1>Add Movie</h1>

<form method="post" class="w-50">
	@* <label>Title:</label> *@
	@* <input class="form-control" type="text" asp-for="Title" placeholder="Title" /> *@
	<div class="form-group">
		<label asp-for="Title" class="control-label"></label>
		<input asp-for="Title" class="form-control" placeholder="Title" data-val-required="The Title field is required." />
		<span asp-validation-for="Title" class="text-danger"></span>
	</div>

	@* <label>Genre:</label>: *@
	@* <input class="form-control" type="text" asp-for="Genre" placeholder="Genre" /> *@
	<div class="form-group">
		<label asp-for="Genre" class="control-label"></label>
		<input asp-for="Genre" class="form-control" placeholder="Genre" data-val-required="The Genre field is required." />
		<span asp-validation-for="Genre" class="text-danger"></span>
	</div>

	@* <label>Price:</label> *@
	@* <input class="form-control" type="number" asp-for="Price" placeholder="Price" /> *@
	<div class="form-group">
		<label asp-for="Price" class="control-label"></label>
		<input asp-for="Price" class="form-control" placeholder="Price" data-val="true" data-val-number="The field Price must be a number." data-val-required="The Price field is required." />
		<span asp-validation-for="Price" class="text-danger"></span>
	</div>
	@* <label>Release Date:</label> *@
	@* <input class="form-control" type="date" asp-for="ReleaseDate" placeholder="Release Date" /> *@
	<div class="form-group">
		<label asp-for="ReleaseDate" class="control-label"></label>
		<input asp-for="ReleaseDate" type="date" class="form-control" placeholder="Release Date" data-val-required="The Release Date field is required." />
		<span asp-validation-for="ReleaseDate" class="text-danger"></span>
	</div>
	<div class="text-end">

		<button type="submit" class="btn btn-primary my-2 " asp-controller="Movie" asp-action="AddMovie">Save</button>

	</div>
</form>

<a asp-action="GetMovies" class="text-primary mt-2">Back to List</a>


		