@using EcommerceMVC.Models.CategoryDtos

@* @{ *@
@*     Layout = "_LayoutUser";  // your dashboard layout *@
@*     ViewData["Title"] = "Movies List"; *@
@* } *@

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Page Title";
}


@model IEnumerable<ResponseCategoryDto>


<div class="row justify-content-between">
    <div>
        <h2>Categories Lists</h2>
    </div>
    <div class="text-end">
        <form method="get">
            <button type="submit" class="btn btn-primary" asp-action="AddCategory" asp-controller="Category">Add New</button>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                Name
            </th>
        </tr>

    </thead>
    <tbody>
       @{
           var i = 1;
       }

        @foreach (var category in Model)
        {
          <tr>
            <td>@i</td>                            
            <td>@category.Name</td>
          </tr>
          i++;
        }
   
    </tbody>
</table>







