@{
    Layout = "_LayoutUser";  // your dashboard layout
    ViewData["Title"] = "Movies List";
}


@* @model IEnumerable<EcommerceMVC.Models.UserDtos.ResponseUserDto> *@

@* @model EcommerceMVC.Models.ApiResponseModel<List<ResponseUserDto>> *@

@model EcommerceMVC.Models.ApiResponseModel<List<EcommerceMVC.Models.UserDtos.ResponseUserDto>>

<h1>User Lists</h1>


<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>User Names</th>
            <th>User Email</th>
            <th>Role Type</th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>

   <tbody>
        @foreach (var user in Model.Data)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.RoleName</td>
                <td><a>Details</a></td>
                <td><a asp-action="EditUser" asp-controller="User" asp-route-id="@user.Id">Edit</a></td>
                <td><a>Delete</a></td>
            </tr>
        }

</tbody>
  
</table>
