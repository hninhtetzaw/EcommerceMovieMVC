@{
}

@model EcommerceMVC.Models.UserDtos.RequestNewUserDto

<h1>Register User</h1>

<form method="post" >
    <div class="form-control">
		<label asp-for="UserName">User Name</label>
        <input asp-for="UserName" type="text" placeholder="UserName" />
        <span asp-validation-for="UserName" class="text-danger"></span>

    </div>
    <div class="form-control">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" placeholder="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>

    </div>
    <div class="form-control">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" placeholder="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>

    </div>
    <button type="submit" asp-controller="User" asp-action="CreateUser">Submit</button>
</form>