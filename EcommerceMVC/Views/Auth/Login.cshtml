@{
}

@model EcommerceMVC.Models.LoginDtos.RequestLoginDto

<form class="form-control w-50" method="post">
	<div>
		<label asp-for="UserName">User Name</label>
		<input type="text" asp-for="UserName" class="form-control" placeholder="UserName...." />
	</div>
	<div>
		<label asp-for="Password">Password</label>
		<input type="password" asp-for="Password" class="form-control" placeholder="Password...." />
	</div>
	<button type="submit" asp-action="Login" asp-controller="Auth" class="btn btn-primary mt-2">Login</button>
</form>